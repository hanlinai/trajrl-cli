# The Go toolchain the released binaries are built with (a pinned image digest).
GO_IMAGE=golang@sha256:87c65a688975c0b1d4585d204874c45ca78354670e3a5f11368c5a492303d696

# The GoReleaser that makes the trajrl releases (.goreleaser.yaml), and the
# Go it builds with: the Go inside GO_IMAGE, the image
# release/build-owner-tools.sh builds in, so both give the same bytes
# (ci.yml checks it). Change GO_VERSION together with GO_IMAGE.
GO_VERSION=1.26.10
GORELEASER_VERSION=v2.20.0
